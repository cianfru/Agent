# --- LLM (required for alerts/briefs; without it the agent runs detection-only) ---
ANTHROPIC_API_KEY=
SYNTH_MODEL=claude-haiku-5-5          # cheap model for alerts and /ask
SYNTH_BRIEF_MODEL=                    # optional stronger model for the daily brief, e.g. claude-opus-5-5
SYNTH_EFFORT=low

# --- Reflex (RCCE_Scanner backend) ---
REFLEX_BASE_URL=https://rccescanner-production.up.railway.app
REFLEX_ACCESS_CODE=                   # a per-agent invite code (revocable); or set REFLEX_TOKEN
REFLEX_TOKEN=

# --- Cowboy (derive_scan published feed; public, no key) ---
COWBOY_BASE_URL=https://raw.githubusercontent.com/cianfru/cowboy-feed/site-data

# --- Hourly pulse (code-built, no model) ---
SYNTH_PULSE_MINUTES=60                # 0 disables
SYNTH_PULSE_MIN_SCORE=40

# --- Telegram push (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Public desk posts on X (via Orbio) ---
SYNTH_POST_MODE=draft                 # draft: store + Telegram, approve via POST /posts/{id}/publish; live: publish
SYNTH_POST_HOUR_UTC=14                # daily post after this hour; scorecard Mondays
ORBIO_API_KEY=
ORBIO_MAX_COST=0.03
BLOCK0_STATS_URL=https://raw.githubusercontent.com/cianfru/Block0/agent-data/stats.json

# --- Service ---
SYNTH_API_KEY=                        # if set, required as X-API-Key on every route but /health
SYNTH_DB=synth.db
SYNTH_POLL_SECONDS=300                # 0 disables the background poller
SYNTH_ALERT_MIN_SCORE=60
SYNTH_MAX_ALERTS_PER_DAY=6            # Telegram alerts per rolling 24h; the rest stay on the dashboard
SYNTH_WALLET_MOVE_MIN_USD=100000
SYNTH_BRIEF_HOUR_UTC=8
SYNTH_FAST_CONVERGENCE_HOURS=6        # Reflex convergences faster than this alert; slower are logged
SYNTH_COINS=                          # optional comma list to restrict coins
